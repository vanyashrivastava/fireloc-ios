# FireLoc Environment Variables

Copy this file to `.env` and fill in your configuration:

# Backend API
EXPO_PUBLIC_API_URL=https://api.fireloc.local
EXPO_PUBLIC_API_TIMEOUT=10000

# Google Maps (optional - works without key in dev mode)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key-here

# Environment
EXPO_PUBLIC_ENV=development

# Firebase / Backend Configuration (when ready)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Feature Flags
EXPO_PUBLIC_ENABLE_MOCK_DATA=true
EXPO_PUBLIC_ENABLE_TEST_NOTIFICATIONS=true
